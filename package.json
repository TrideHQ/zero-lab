{
  "name": "zero-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "0⁰ Lab — every science topic, in 3D. Then do the practical with your own hands.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/content.ts",
    "test": "node --test tests/*.test.ts",
    "start": "node server/index.ts",
    "build:api": "esbuild server/api/partner.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/partner.js",
    "draft": "node scripts/draft-topic.ts",
    "diagrams": "node scripts/render-diagrams.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "katex": "^0.16.11",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.170.0",
    "ajv": "^8.17.1",
    "iwer": "^2.0.1",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^7.1.4"
  }
}
