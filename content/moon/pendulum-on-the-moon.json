  "summary": {
    "en": "The same pendulum swings more slowly on the Moon, and its period tells you the Moon's gravity."
  },
  "cards": [
    {
      "title": {
        "en": "A clock that feels gravity"
      },
      "text": {
        "en": "A pendulum's period depends on its length and on g. Take the same pendulum to the Moon and only g changes."
      },
      "equation": "T = 2\\pi\\sqrt{\\dfrac{L}{g}}",
      "modelState": {
        "L": 0.6,
        "amp": 10,
        "g": 9.81,
        "running": true
      }
    },
    {
      "title": {
        "en": "Lazy swings"
      },
      "text": {
        "en": "On the Moon g is about 1.62 m/s². The swing is slower: the period is about two and a half times longer than on Earth for the same length."
      },
      "equation": null,
      "modelState": {
        "L": 0.6,
        "amp": 10,
        "g": 1.62,
        "running": true
      }
    },
