  "summary": {
    "en": "A small force far from the pivot can balance a large force close to it."
  },
  "cards": [
    {
      "title": {
        "en": "The turning effect of a force"
      },
      "text": {
        "en": "A force can turn an object about a pivot. The turning effect is called the moment. It depends on the size of the force and on how far from the pivot it acts."
      },
      "equation": "\\text{moment} = F \\times d",
      "modelState": {
        "m1": 0.2,
        "d1": 0.4,
        "m2": 0.2,
        "d2": 0.2,
        "arrows": true
      }
    },
    {
      "title": {
        "en": "Distance matters"
      },
      "text": {
        "en": "Slide the right-hand mass along the rule. Further from the pivot, the same weight has a bigger moment. The distance is always measured at right angles to the force."
      },
      "equation": null,
      "modelState": {
        "m1": 0.2,
        "d1": 0.4,
        "m2": 0.2,
        "d2": 0.45,
        "arrows": true
      }
    },
    {
      "title": {
        "en": "The principle of moments"
      },
      "text": {
        "en": "When the rule balances, the total clockwise moment equals the total anticlockwise moment about the pivot. Here a heavier mass close in balances a lighter one further out."
      },
      "equation": "F_1 d_1 = F_2 d_2",
      "modelState": {
        "m1": 0.2,
        "d1": 0.4,
        "m2": 0.4,
        "d2": 0.2,
        "arrows": true
      }
    },
    {
      "title": {
        "en": "Equilibrium needs two conditions"
      },
      "text": {
        "en": "For an object to stay at rest the moments must balance and the forces must balance too. The pivot pushes up with a force equal to the total weight."
      },
      "equation": null,
      "modelState": {
        "m1": 0.3,
        "d1": 0.3,
        "m2": 0.45,
        "d2": 0.2,
        "arrows": true
      }
    }
  ],
