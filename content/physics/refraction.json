  "summary": {
    "en": "Light changes direction when it crosses from one transparent material into another."
  },
  "cards": [
    {
      "title": {
        "en": "What is refraction?"
      },
      "text": {
        "en": "Shine a ray of light at a glass block and it bends as it goes in. This change of direction at a boundary is called refraction. It happens because light travels more slowly in glass than in air."
      },
      "equation": null,
      "modelState": {
        "angle": 30,
        "showNormal": false,
        "photons": false
      }
    },
    {
      "title": {
        "en": "The normal and the two angles"
      },
      "text": {
        "en": "Draw a line at 90° to the surface where the ray meets it. That line is the normal. The angle of incidence i and the angle of refraction r are both measured from the normal, never from the surface."
      },
      "equation": null,
      "modelState": {
        "angle": 40,
        "showNormal": true,
        "photons": false
      }
    },
    {
      "title": {
        "en": "Snell's law"
      },
      "text": {
        "en": "For two given materials, sin i divided by sin r always gives the same number. For air into a material that number is its refractive index n. Drag the ray box and watch r follow the rule."
      },
      "equation": "n_1 \\sin\\theta_1 = n_2 \\sin\\theta_2",
      "modelState": {
        "angle": 55,
        "showNormal": true,
        "photons": false
      }
    },
    {
      "title": {
        "en": "Slower light, bigger bend"
      },
      "text": {
        "en": "The refractive index compares the speed of light in a vacuum with its speed in the material. Watch the light slow down inside the block. A larger n means slower light and more bending."
      },
      "equation": "n = \\dfrac{c}{v}",
      "modelState": {
        "angle": 55,
        "showNormal": true,
        "photons": true,
        "n": 1.9
      }
    }
  ],
