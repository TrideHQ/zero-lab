      "title": {
        "en": "Charge on the move"
      },
      "text": {
        "en": "Close the switch and electrons drift around the loop. The rate at which charge flows is the current I, measured in amperes with an ammeter placed in series."
      },
      "equation": null,
      "modelState": {
