      "title": {
        "en": "Series resistances add"
      },
      "text": {
        "en": "Each resistor takes a share of the battery's potential difference, and the shares add up to the total. The combined resistance is the sum of the two."
      },
      "equation": "R = R_1 + R_2",
      "modelState": {
        "switchOn": true,
        "R1": 4,
