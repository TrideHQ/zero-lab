  "reviewed": false,
  "summary": {
    "en": "Hang more load on a spring and it stretches in proportion, up to a limit."
  },
  "cards": [
    {
      "title": {
        "en": "Stretching a spring"
      },
      "text": {
        "en": "Hang a mass on a spring and it gets longer. The extra length is called the extension e. It is the new length minus the original length, not the whole length."
      },
      "equation": null,
      "modelState": {
        "mass": 0.2,
        "arrows": false
      }
    },
    {
      "title": {
        "en": "Twice the load, twice the stretch"
      },
      "text": {
        "en": "Add masses one at a time. Each equal load adds an equal extension, so force and extension are proportional. This is Hooke's law."
      },
      "equation": "F = ke",
      "modelState": {
        "mass": 0.4,
        "arrows": true
      }
    },
    {
      "title": {
        "en": "The spring constant"
      },
      "text": {
        "en": "The constant k tells you how stiff the spring is: the force needed for each metre of extension. Change k and watch the same load stretch the spring by a different amount."
      },
      "equation": "k = \\dfrac{F}{e}",
      "modelState": {
        "mass": 0.4,
        "k": 40,
        "arrows": true
      }
    },
    {
      "title": {
        "en": "The elastic limit"
      },
      "text": {
        "en": "Load the spring too far and the pattern breaks. Past the elastic limit the spring stretches more than the law predicts and will not return to its original length."
      },
      "equation": null,
      "modelState": {
        "mass": 0.65,
        "k": 25,
        "arrows": true
      }
    }
  ],
