  "summary": {
    "en": "Without air, everything falls with the same acceleration."
  },
  "cards": [
    {
      "title": {
        "en": "Falling under gravity"
      },
      "text": {
        "en": "Let go of an object and the Earth's gravity pulls it down. It does not fall at a steady speed: it gets faster every moment. This is free fall."
      },
      "equation": null,
      "modelState": {
        "gravity": "earth",
        "air": false,
        "dropped": true
      }
    },
    {
      "title": {
        "en": "The same for every mass"
      },
      "text": {
        "en": "Drop a heavy ball and a light ball together with the air removed. They land at the same time. The acceleration of free fall g does not depend on mass. Near the Earth's surface it is about 9.8 m/s²."
      },
      "equation": "s = \\tfrac{1}{2} g t^2",
      "modelState": {
        "gravity": "earth",
        "air": false,
        "dropped": true
      }
    },
    {
      "title": {
        "en": "Air gets in the way"
      },
      "text": {
        "en": "Turn the air back on. Air resistance grows with speed and matters more for light objects, so the small ball falls behind. In everyday life this is why a leaf falls slower than a stone."
      },
      "equation": null,
      "modelState": {
        "gravity": "earth",
        "air": true,
        "dropped": true
      }
    },
    {
      "title": {
        "en": "Gravity is universal"
      },
      "text": {
        "en": "Every mass attracts every other mass. The pull gets weaker with distance and stronger with mass. The Moon has less mass than the Earth, so g there is only about 1.6 m/s²."
      },
      "equation": "F = \\dfrac{G m_1 m_2}{r^2}",
      "modelState": {
        "gravity": "moon",
        "air": false,
        "dropped": true
      }
    }
