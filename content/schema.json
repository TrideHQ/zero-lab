{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zero-lab/content/topic.schema.json",
  "title": "0⁰ Lab topic",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "subject", "unit", "title", "curricula", "reviewed", "summary", "cards", "images", "model", "checks", "practical", "related"],
  "definitions": {
    "text": {
      "description": "Localised text. 'en' is required and is the fallback for every other locale.",
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "patternProperties": { "^[a-z]{2}$": { "type": "string", "minLength": 1 } }
    },
    "state": { "type": "object", "additionalProperties": { "type": ["number", "boolean", "string"] } },
    "mapping": {
      "description": "How one exam board names and places this topic. null = the board does not list it.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["topic", "level", "verified"],
          "properties": {
            "topic": { "type": "string", "minLength": 2, "maxLength": 120 },
            "unit": { "type": "string", "minLength": 2, "maxLength": 120 },
            "level": { "type": "string", "minLength": 1, "maxLength": 40 },
            "verified": { "type": "boolean" }
          }
        }
      ]
    }
  },
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "subject": { "enum": ["physics", "moon"] },
    "unit": { "$ref": "#/definitions/text" },
    "title": { "$ref": "#/definitions/text" },
    "curricula": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/mapping" }
    },
    "reviewed": { "type": "boolean" },
    "summary": { "$ref": "#/definitions/text" },
    "cards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "text", "equation", "modelState"],
        "properties": {
          "title": { "$ref": "#/definitions/text" },
          "text": { "$ref": "#/definitions/text" },
          "equation": { "type": ["string", "null"] },
          "modelState": { "$ref": "#/definitions/state" }
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "state", "caption"],
            "properties": {
              "type": { "const": "generated" },
              "template": { "enum": ["ray-optics", "circuit-board", "forces-rig", "sky-moon"] },
              "preset": { "type": "string" },
              "state": { "$ref": "#/definitions/state" },
              "caption": { "$ref": "#/definitions/text" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "src", "credit", "caption"],
            "properties": {
              "type": { "const": "file" },
              "src": { "type": "string", "pattern": "^/img/" },
              "credit": { "type": "string", "minLength": 8 },
              "caption": { "$ref": "#/definitions/text" }
            }
          }
        ]
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "preset", "params"],
      "properties": {
        "template": { "enum": ["ray-optics", "circuit-board", "forces-rig", "sky-moon"] },
        "preset": { "type": "string" },
        "params": { "$ref": "#/definitions/state" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["q", "type", "target"],
            "properties": {
              "q": { "$ref": "#/definitions/text" },
              "type": { "const": "point" },
              "target": { "type": "string" },
              "modelState": { "$ref": "#/definitions/state" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["q", "type", "options", "answer"],
            "properties": {
              "q": { "$ref": "#/definitions/text" },
              "type": { "const": "choice" },
              "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/definitions/text" } },
              "answer": { "type": "integer", "minimum": 0 }
            }
          }
        ]
      }
    },
    "practical": { "type": ["string", "null"] },
    "practicalVariant": { "type": "string" },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
